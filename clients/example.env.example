# Ejemplo no sensible. Los .env reales se generan con scripts/new_client.py
# y quedan ignorados por Git.

APP_ENV="development"
APP_NAME="Cliente Demo Agent"
APP_SLUG="cliente_demo"
APP_URL="https://cliente-demo.example.com"
SECRET_KEY="CAMBIAR"
ENCRYPTION_KEY="CAMBIAR"
SESSION_COOKIE="cliente_demo_session"
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE="lax"
SESSION_MAX_AGE=604800
ALLOWED_HOSTS="localhost,127.0.0.1,testserver"
CORS_ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"
DATABASE_URL="sqlite:///./cliente_demo.db"
MASTER_DATABASE_URL="sqlite:///./master.db"
ENABLE_DEMO_BOOTSTRAP=false
DEBUG=false

DEFAULT_COMPANY_NAME="Cliente Demo SL"
DEFAULT_ADMIN_EMAIL="admin@cliente-demo.com"
DEFAULT_ADMIN_PASSWORD="CAMBIAR"

BRANDING_APP_NAME="Cliente Demo Agent"
BRANDING_PRIMARY_CLAIM="Gestion inteligente de pedidos"
BRANDING_SECONDARY_CLAIM=""
BRANDING_LOGO_URL=""
BRANDING_DARK_LOGO_URL=""
BRANDING_FAVICON_URL=""

EMAIL_SIGNATURE_TEXT="Equipo de pedidos"

# Meta WhatsApp Embedded Signup. Configuracion de plataforma, no del usuario final.
META_APP_ID=""
META_APP_SECRET=""
META_EMBEDDED_SIGNUP_CONFIG_ID=""
META_GRAPH_API_VERSION="v24.0"
META_EMBEDDED_SIGNUP_VERSION="v4"
# Opcional: solo para registrar numeros nuevos de Cloud API; coexistencia no lo usa.
META_WHATSAPP_REGISTRATION_PIN=""
META_WHATSAPP_VERIFY_TOKEN=""
META_OAUTH_REDIRECT_URI=""
META_REQUEST_TIMEOUT_SECONDS=20
