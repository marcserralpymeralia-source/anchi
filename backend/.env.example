# Copia este archivo como .env para cada cliente.
# No subas .env al repositorio.

APP_ENV="development"
APP_NAME="Anchi"
APP_SLUG="anchi"

# Clave para sesiones. En produccion usa una propia y fuerte.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="CAMBIAR_POR_CLAVE_SEGURA"

# Clave Fernet para cifrar credenciales y secretos almacenados.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="CAMBIAR_POR_CLAVE_FERNET"

SESSION_COOKIE="anchi_session"
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE="lax"
SESSION_MAX_AGE=604800

ALLOWED_HOSTS="localhost,127.0.0.1,testserver"
CORS_ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001"

# SQLite es suficiente para demo/local. En produccion usa PostgreSQL o similar.
DATABASE_URL="sqlite:///./anchi_demo.db"
MASTER_DATABASE_URL="sqlite:///./master.db"
# DATABASE_URL="postgresql+psycopg://user:password@host:5432/anchi_demo"
# MASTER_DATABASE_URL="postgresql+psycopg://user:password@host:5432/anchi_master"

# Jobs y workers.
JOB_POLL_INTERVAL_SECONDS=10
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=15
JOB_RETRY_MAX_SECONDS=300
JOB_STALE_AFTER_SECONDS=900
LOG_FORMAT="json"
LOG_LEVEL="info"

# Bootstrap demo solo para desarrollo local.
ENABLE_DEMO_BOOTSTRAP=true
DEBUG=false

# Usuario inicial solo para primera puesta en marcha.
DEFAULT_COMPANY_NAME="Anchi Demo"
DEFAULT_ADMIN_EMAIL="admin@anchi.local"
DEFAULT_ADMIN_PASSWORD="admin123"

# Identidad inicial. Luego se puede ajustar desde Configuracion > Identidad corporativa.
BRANDING_APP_NAME="Anchi"
BRANDING_PRIMARY_CLAIM="Gestion inteligente de pedidos"
BRANDING_SECONDARY_CLAIM=""
BRANDING_LOGO_URL=""
BRANDING_DARK_LOGO_URL=""
BRANDING_FAVICON_URL=""

EMAIL_SIGNATURE_TEXT="Equipo de pedidos"
