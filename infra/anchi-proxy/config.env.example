# The gateway only exposes an authenticated health check. Data forwarding is
# intentionally disabled until tenant isolation, TLS and the destination
# adapter are implemented.
PROXY_ENABLED=0
# Keep the gateway private; expose only the HTTPS reverse proxy.
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8787
LOG_LEVEL=INFO
PROXY_AUTH_USERNAME=anchi-proxy-demo
PROXY_AUTH_PASSWORD=generate-a-long-random-password
